# Copy this file to .env and paste your RustMaps API key after the =
# Optional: only needed for `python rustloc.py fetch SIZE_SEED` (maps no tracked server runs).
# Get a key from your account on https://rustmaps.com
RUSTMAPS_API_KEY=

# Optional settings
# RUSTLOC_SYNC_HOURS=6        # how often the UI re-checks servers for wipes (0 = only via "Sync now")
# RUSTLOC_DATA=maps           # where downloaded maps are stored
# RUSTLOC_ASSETS=assets       # where downloaded pictures are stored
